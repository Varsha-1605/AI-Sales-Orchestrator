# Claude API key. Leave empty to run with keyword routing and template replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Fallback: used when the Claude call fails, or when no Anthropic key is set
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG_MODE=true
# JSON list of allowed browser origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Seconds to wait for one LLM call, and how many times to retry it
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# Send one tiny request to each model at startup so the first customer does not wait for the connection
WARMUP_LLM=true

# Set to true in production: every request must send the X-Session-Token returned by session/create
AUTH_ENABLED=false
# Requests per minute per client IP on the chat, payment and translate endpoints
RATE_LIMIT_PER_MINUTE=60
# true = one JSON object per log line
LOG_JSON=false
# Seconds between pieces of a streamed reply (0 = send the text at once)
STREAM_PIECE_DELAY_SECONDS=0.03

# Redis: live sessions and carts
REDIS_URL=redis://localhost:6379/0
SESSION_TIMEOUT_SECONDS=3600

# Postgres: orders, preferences, feedback, LangGraph checkpoints. Leave empty to run without it.
POSTGRES_URL=postgresql://sales:sales@localhost:5432/sales
POSTGRES_POOL_MAX_SIZE=10

# Payment gateways, tried in this order (JSON list)
PAYMENT_GATEWAY_ORDER=["Razorpay","PayU","UPI Direct"]
PAYMENT_GATEWAY_TIMEOUT_SECONDS=5

# Set to false to skip the prompt-injection checks
GUARDRAILS_ENABLED=true

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-sales-orchestrator

# Folder with products.json, stores.json, customers.json
DATA_DIR=data
